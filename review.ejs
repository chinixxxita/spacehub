<section><div class="page-heading"><div><div class="eyebrow">RESERVATION FLOW · 2 OF 3</div><h1>Review Reservation</h1><p>Check the details before submitting your request.</p></div></div>
<div class="card review-card"><div class="review-header"><div><span class="facility-type"><%= room.type %></span><h2><%= room.name %></h2><p><%= room.description %></p></div><span class="badge pending">Pending Approval</span></div>
<div class="review-grid"><div><span>Date</span><strong><%= reservation.reservation_date %></strong></div><div><span>Time</span><strong><%= reservation.start_time %> – <%= reservation.end_time %></strong></div><div><span>Number of Users</span><strong><%= reservation.number_of_users %></strong></div><div><span>Purpose</span><strong><%= reservation.purpose %></strong></div><div><span>Requested By</span><strong><%= currentUser.full_name %></strong></div><div><span>Facility</span><strong><%= room.type %></strong></div></div>
<div class="review-details"><span>Purpose Details</span><p><%= reservation.purpose_details %></p></div>
<% if (reservation.extra_chairs === 'Yes') { %><div class="notice"><strong>Additional chairs requested</strong> for <%= reservation.number_of_users - room.capacity %> extra <%= (reservation.number_of_users - room.capacity) === 1 ? 'person' : 'people' %> (facility capacity: <%= room.capacity %>).</div><% } else if (reservation.extra_chairs === 'No') { %><div class="notice"><strong>Over capacity:</strong> your group is larger than the facility capacity of <%= room.capacity %>. No additional chairs requested.</div><% } %>
<% if(room.type==='Laboratory'){ %><div class="notice"><strong>Laboratory reservation:</strong> Students may only access the laboratory with an instructor. Only <%= computersAvailable %> computers are available.</div><% } %>
<div class="form-footer"><a class="button-link-dark" href="/reservations/new">← Edit Reservation</a><form action="/reservations/submit" method="post"><% Object.entries(reservation).forEach(([key,value])=>{ %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }) %><button class="primary" type="submit">Submit Reservation</button></form></div></div></section>
